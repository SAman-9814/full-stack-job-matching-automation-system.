# ─────────────────────────────────────────────────────────
# CareerSync AI — Backend Environment Variables
# ─────────────────────────────────────────────────────────
# Copy this file to .env for local dev.
# For Vercel: add these in Project → Settings → Environment Variables

# Express server port (Vercel ignores this — it manages ports itself)
PORT=5000

# MongoDB Atlas connection string
# Get from: Atlas Dashboard → Cluster → Connect → Drivers → Copy URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# MongoDB Database name
DB_NAME=PORTFOLIOODB

# Allowed frontend origin for CORS
# Local dev:
FRONTEND_URL=http://localhost:5173
# Vercel production (set this in Vercel dashboard):
# FRONTEND_URL=https://your-frontend.vercel.app
